// StudyOS database schema.
// Postgres (Neon) for development and production. `DATABASE_URL` is the pooled
// connection used at runtime; `DATABASE_URL_UNPOOLED` is the direct connection
// used for migrations / `prisma db push`.

generator client {
  provider = "prisma-client-js"
  output   = "../src/generated/prisma"
  // "native" keeps local dev (Windows) working; "debian-openssl-3.0.x" is the
  // query-engine binary for the node:22-slim (Debian bookworm) Cloud Run image.
  binaryTargets = ["native", "debian-openssl-3.0.x"]
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DATABASE_URL_UNPOOLED")
}

// A saved workspace. The full workspace tree is stored as JSON in `data`;
// `name`/`icon` are denormalized so we can list workspaces without parsing it.
// `ownerId` defaults to "local" until real auth (Clerk) is added.
// `deletedAt` is set when the student moves the workspace to the trash. Trashed
// workspaces are invisible to every reader (editor, list, agents, calendar
// feed) and can be restored for 30 days; after that they are purged.
model Workspace {
  id        String    @id
  ownerId   String    @default("local")
  name      String
  icon      String?
  data      String
  version   Int       @default(1)
  // The save log (JSON, lib/workspace/save-ids.ts): for each editor tab its
  // latest save that landed and the version it produced, plus the version the
  // log was last written at. Written in the same statement as `data`, so a
  // tab whose save landed without its reply (or a draft left by a closed tab)
  // can tell for certain, and is told when it cannot. No schema change since
  // 20261114020000_workspace_save_ids: the column only holds another format.
  saveIds   String    @default("")
  deletedAt DateTime?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  changes   WorkspaceChange[]
  agentMessages AgentChatMessage[]
  materials StudyMaterial[]
  feeds     CalendarFeed[]
  shares    PageShare[]

  @@index([ownerId])
  @@index([ownerId, deletedAt])
}

// Course material a student added to a workspace (lecture slides, notes,
// readings, or the text of one of their pages) to make study material from.
// Text is kept per page so every generated flashcard and question can cite
// the page it came from, and the citation viewer can show that page.
// `pages` is a JSON string[]; `pageChars` (JSON number[]) lets the client plan
// a run and show its cost without loading the text. Owner-scoped; hidden while
// its workspace is in the trash and removed with it (ON DELETE CASCADE).
model StudyMaterial {
  id           String    @id @default(cuid())
  ownerId      String
  workspaceId  String
  title        String
  kind         String
  pages        String
  pageChars    String
  pageCount    Int
  charCount    Int
  sourcePages  Int
  truncated    Boolean   @default(false)
  contentHash  String
  sourcePageId String?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
  workspace    Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@index([ownerId])
  @@index([workspaceId, ownerId, createdAt])
}

// Append-only history of agent (and undo) edits to a workspace. Each row keeps
// the exact before/after snapshots and the version each one moved between, so an
// agent change can be atomically reverted without trusting client-supplied JSON.
model WorkspaceChange {
  id            String    @id @default(cuid())
  workspaceId   String
  ownerId       String
  kind          String    @default("agent")
  beforeData    String
  afterData     String
  beforeVersion Int
  afterVersion  Int
  undoneAt      DateTime?
  createdAt     DateTime  @default(now())
  workspace     Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@unique([workspaceId, afterVersion])
  @@index([workspaceId, ownerId, createdAt])
}

// A durable, owner-scoped record of one agent task. Survives a disconnect so the
// user can reconnect and receive the result, and carries a cancel flag the apply
// step consults before committing. `result` holds the final stream payload;
// rows expire ~10 minutes after creation.
model AgentTask {
  id          String   @id @default(cuid())
  userId      String
  workspaceId String
  baseVersion Int
  status      String   @default("running")
  result      String?
  error       String?
  events      String?
  expiresAt   DateTime
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([userId, workspaceId])
}

// One row per user controlling the Daily Study Agent. The agent is intentionally
// workspace-read-only: it derives a daily plan but never edits source coursework.
// `timeZone` is an IANA zone captured from the browser (for example,
// "Europe/Berlin") so "today" follows the student's calendar day.
model DailyStudyAgentConfig {
  userId       String   @id
  enabled      Boolean  @default(true)
  dailyMinutes Int      @default(60)
  timeZone     String   @default("UTC")
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

// The current plan for one local calendar day. Items are stored as validated
// JSON text so the planner can evolve its item shape without coupling the
// workspace's flexible JSON document model to a rigid relational schema.
model DailyStudyPlan {
  id             String   @id @default(cuid())
  userId         String
  localDate      String
  timeZone       String
  summary        String
  items          String
  sourceCount    Int      @default(0)
  candidateCount Int      @default(0)
  // 1: English sentences in summary/items. 2: structured items rendered
  // through the i18n dictionaries; plan-level data (workload check, exam
  // countdowns, effort ledger) lives in `details` as validated JSON.
  version        Int      @default(1)
  details        String   @default("{}")
  generatedAt    DateTime @default(now())
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@unique([userId, localDate])
  @@index([userId, generatedAt])
}

// Long-lived, transparent activity history for user-facing agents. Unlike the
// short-lived AgentTask transport rows, these records remain available in the
// Agent Center so a student can inspect what ran and why.
model AgentRun {
  id          String    @id @default(cuid())
  userId      String
  agentKey    String
  trigger     String
  status      String    @default("running")
  summary     String?
  error       String?
  startedAt   DateTime  @default(now())
  completedAt DateTime?

  @@index([userId, startedAt])
  // The operator console's "Recent failed runs" (status + time window).
  @@index([status, startedAt])
}

// One row per user (Clerk user id) tracking their Stripe subscription.
model Subscription {
  userId               String    @id
  stripeCustomerId     String?
  stripeSubscriptionId String?
  status               String    @default("free")
  currentPeriodEnd     DateTime?
  // The paid billing period behind the Pro credit allowance (set from the
  // latest qualifying paid invoice). Annual subscribers accrue one monthly
  // allowance per anniversary inside it; see lib/credits.ts.
  allowancePeriodStart DateTime?
  allowancePeriodEnd   DateTime?
  // When the live Stripe state written here was fetched: a write carrying an
  // older fetch never overwrites a newer one (concurrent webhooks). Only this
  // code writes it, so a row where it is null was last written by the code
  // before it (lib/billing.ts reconcileUnsyncedSubscriptions re-reads those).
  stripeSyncedAt           DateTime?
  // A subscription this code saw ended on a live Stripe read, and when it
  // ended. Stripe never revives an ended subscription, so a live status for
  // it is stale. Written only from live reads: a status written by older
  // code can never lock a subscriber out.
  endedSubscriptionId      String?
  endedAt                  DateTime?
  // When the maintenance job last re-read this row (it takes the least
  // recently checked first, so a row that keeps failing never blocks others).
  stripeCheckedAt          DateTime?
  // The subscription and payment the allowance period belongs to. Cleared
  // when another subscription is adopted.
  allowanceSubscriptionId  String?
  allowancePaymentIntentId String?
  allowancePaymentCents    Int?
  // Only a yearly period accrues further monthly allowances.
  allowanceYearly          Boolean   @default(false)
  // Derived (lib/billing.ts refreshAllowanceState, from the facts above and
  // the payment's refunds and disputes), never written anywhere else:
  //  - no allowance month on or after allowanceStopAt (the subscription
  //    ended, or its payment is refunded in full);
  //  - disputeId: an open or lost dispute on the payment of the current
  //    period: not Pro, and no accrual from disputedAt.
  allowanceStopAt          DateTime?
  disputeId                String?
  disputedAt               DateTime?
  updatedAt            DateTime  @updatedAt

  // The webhook resolves invoices/subscription events back to a user by
  // subscription id (or customer id) when metadata is missing.
  @@index([stripeSubscriptionId])
  @@index([stripeCustomerId])
}

// Audit trail of money-moving Stripe events that are not plain grants:
// refunds, disputes, duplicate-subscription and deleted-account cleanups.
// (kind, stripeObjectId) makes webhook retries idempotent.
model BillingEvent {
  id              String   @id @default(cuid())
  userId          String?
  kind            String
  stripeObjectId  String
  paymentIntentId String?
  amountCents     Int?
  credits         Int?
  detail          String?
  // When it happened on Stripe (a refund's or dispute's own timestamp), so
  // what it affects does not depend on when its webhook arrived.
  occurredAt      DateTime?
  createdAt       DateTime @default(now())

  @@unique([kind, stripeObjectId])
  @@index([paymentIntentId])
  @@index([userId])
  // The operator console's billing window (last 30 days).
  @@index([createdAt])
}

// Tombstone written when a user deletes their account, so a late Stripe
// webhook cannot recreate billing rows or grant credits for them.
model DeletedAccount {
  userId    String   @id
  deletedAt DateTime @default(now())
}

// A billing job that must finish even if Stripe fails part-way: written
// BEFORE the first Stripe call and completed idempotently by any later event,
// retry or the maintenance job (lib/billing.ts runBillingMaintenance).
//   kind "refund_subscription": cancel and refund a subscription that must not
//     exist (key = Stripe subscription id; reason = duplicate_subscription or
//     deleted_account_subscription). Its invoices never grant credits.
//   kind "cancel_account_billing": stop every subscription of a deleted
//     account (key = user id; the Stripe ids are captured before erasure).
model BillingIntent {
  id                   String    @id @default(cuid())
  kind                 String
  key                  String
  userId               String?
  reason               String?
  stripeCustomerId     String?
  stripeSubscriptionId String?
  state                String    @default("pending")
  attempts             Int       @default(0)
  lastError            String?
  createdAt            DateTime  @default(now())
  updatedAt            DateTime  @updatedAt
  completedAt          DateTime?

  @@unique([kind, key])
  @@index([state, updatedAt])
}

// Credits reserved for AI work in progress (lib/credits.ts reserveCredits).
// `amount` is taken from the balance when the hold is made; settling charges
// the real cost and returns the difference, releasing returns it all, and a
// hold left "held" past `expiresAt` (a crashed request) is released.
// `pendingCharge` is written before a settle runs: a hold that has one is
// never given back, it is settled (by the next release or the maintenance
// job), so a settle that failed does not give the work away.
model CreditHold {
  id            String    @id @default(cuid())
  userId        String
  amount        Int
  reason        String
  state         String    @default("held")
  charged       Int?
  pendingCharge Int?
  expiresAt     DateTime
  createdAt     DateTime  @default(now())
  settledAt     DateTime?

  @@index([userId, state])
  @@index([state, expiresAt])
}

// One row per rate-limited action (AI request, sandbox run) and per funnel
// milestone. Counted over sliding windows to enforce per-user limits that are
// correct across instances; also doubles as first-party funnel analytics.
model UsageEvent {
  id        String   @id @default(cuid())
  userId    String
  kind      String
  createdAt DateTime @default(now())

  @@index([userId, kind, createdAt])
}

// Flashcard reviews per student, per workspace, per LOCAL calendar day (the
// student's day when they answered, YYYY-MM-DD). Drives the study streak and
// the statistics view; incremented in small batches by the review UI. The
// schedule itself lives on the cards in the workspace JSON. Rows outlive a
// deleted workspace on purpose: past study still counts toward the streak.
model StudyDay {
  userId       String
  workspaceId  String
  localDate    String
  reviews      Int      @default(0)
  again        Int      @default(0)
  hard         Int      @default(0)
  good         Int      @default(0)
  easy         Int      @default(0)
  newCards     Int      @default(0)
  reviewTotal  Int      @default(0)
  reviewPassed Int      @default(0)
  practice     Int      @default(0)
  // Quiz answers (practice and exam), and how many of them were right.
  quizAnswers  Int      @default(0)
  quizCorrect  Int      @default(0)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@id([userId, workspaceId, localDate])
  @@index([userId, localDate])
}

// One focus-timer block a student ran (src/app/app/focus-actions.ts): how many
// seconds they actually focused, on their LOCAL calendar day (YYYY-MM-DD, the
// day the block started). `workspaceId` and `itemKey` (the Today plan item it
// was started from) are optional: a session can be about nothing in
// particular. `clientId` is the browser's random id for the block, so a
// retried request never counts it twice. `completed` = the block ran to the
// end (false: stopped early). Rows outlive a deleted workspace, like StudyDay.
model FocusSession {
  id          String   @id @default(cuid())
  userId      String
  workspaceId String?
  itemKey     String?
  label       String?
  clientId    String
  localDate   String
  startedAt   DateTime
  seconds     Int
  completed   Boolean
  createdAt   DateTime @default(now())

  @@unique([userId, clientId])
  @@index([userId, localDate])
}

// A per-user unguessable capability token for the read-only ICS calendar feed.
// The feed URL (/api/calendar/<token>) is fetched by calendar apps that can't
// authenticate, so the token IS the credential. One active token per user;
// resetting rotates it and revokes the old URL.
model CalendarToken {
  token     String   @id
  userId    String   @unique
  createdAt DateTime @default(now())
}

// An incoming calendar feed (an iCalendar link from Canvas, Moodle, Blackboard,
// Brightspace or Google Calendar) a student connected to one database of a
// workspace, so their deadlines arrive and stay in sync on their own.
// The link is a credential (anyone holding it can read the student's
// calendar), so it lives only here, sealed (lib/feeds/secret.ts): never in the
// workspace document (which the AI reads), never sent back to the browser,
// never logged. `urlHash` (SHA-256 of the normalized link) stops the same link
// being connected twice. Rows imported from the feed carry only this record's
// id and the event UID (DatabaseRow.source). `settings` is JSON (column
// mapping, events already decided on, followed repeating events);
// `lastSummary` is JSON (what the last sync changed). Removed with the
// workspace (ON DELETE CASCADE) and on account erasure.
model CalendarFeed {
  id             String    @id @default(cuid())
  userId         String
  workspaceId    String
  databaseId     String
  urlSealed      String
  urlHash        String
  label          String
  platform       String    @default("other")
  settings       String    @default("{}")
  lastSyncedAt   DateTime?
  lastAttemptAt  DateTime?
  lastError      String?
  lastSummary    String?
  syncLeaseUntil DateTime?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
  workspace      Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@unique([workspaceId, urlHash])
  @@index([userId])
}

// A user's AI credit balance. Credits are spent per AI request based on the
// GLM 5.2 tokens it actually used (see lib/credits.ts).
model CreditAccount {
  userId    String   @id
  balance   Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // The operator console's new-account counts per window.
  @@index([createdAt])
}

// Append-only audit trail of every credit change (grant, purchase, usage).
// `idempotencyKey` makes grants safe to retry (Stripe webhook + success redirect).
model CreditLedger {
  id             String   @id @default(cuid())
  userId         String
  delta          Int
  reason         String
  idempotencyKey String?  @unique
  createdAt      DateTime @default(now())

  @@index([userId])
  // The operator console's spending and active-student windows.
  @@index([createdAt])
}

// A student's invite link (/r/<code>, lib/referral), made the first time
// they open their invite card. `code`: 8 characters from an unambiguous
// alphabet (no 0/O or 1/I/L), drawn from the OS CSPRNG. Exported and erased
// with the account.
model ReferralCode {
  userId    String   @id
  code      String   @unique
  createdAt DateTime @default(now())
}

// A friend who set up a NEW account through someone's invite link, at most
// one row per friend (lib/referral/attribution.ts). `status`:
//   pending   attributed; rewarded once the friend's first workspace build is
//             charged (`qualifiedAt`) and their email is verified;
//   rewarded  decided (`rewardedAt`): the friend got the bonus, and
//             `referrerOutcome` says what the inviter got: granted |
//             capped_total | capped_daily | referrer_deleted;
//   rejected  never rewarded; `rejectReason`: self_referral |
//             referrer_deleted | account_not_new | cookie_expired |
//             bad_signature | same_email | mailbox_reused.
// `lastTriedAt`: the maintenance job's last attempt (it retries the least
// recently tried first). The credits themselves are CreditLedger rows
// (reasons referral_referee and referral_referrer, keyed by the friend's id).
// When the INVITER deletes their account, their rows are erased; when the
// FRIEND does, their row is anonymised instead (`refereeId` cleared, status,
// outcome and dates kept: the operator console's evidence about the inviter).
// Credits already granted to the other side stay. A unique index ignores
// NULLs, so any number of anonymised rows can coexist.
model Referral {
  id              String    @id @default(cuid())
  referrerId      String
  refereeId       String?   @unique
  code            String
  status          String    @default("pending")
  rejectReason    String?
  qualifiedAt     DateTime?
  rewardedAt      DateTime?
  referrerOutcome String?
  lastTriedAt     DateTime?
  createdAt       DateTime  @default(now())

  @@index([referrerId, status])
  @@index([status, createdAt])
}

// The invite program's pseudonymous mailbox register (lib/referral/mailbox.ts):
// one row per invite credit granted, naming only an HMAC-SHA256 of the
// mailbox it went to (lower case, no +tag, Gmail dots and googlemail.com
// folded), keyed by a server-derived key, and the side it was for (`role`:
// friend | inviter). No user id, no address. It is what stops one mailbox
// farming invites across accounts: a friend's mailbox earns the friend bonus
// once ever, and the inviter's caps count per mailbox across all of their
// accounts. Kept when an account is erased (that is the point; it identifies
// no one without the server key and the address itself).
model ReferralMailbox {
  id        String   @id @default(cuid())
  hash      String
  role      String
  createdAt DateTime @default(now())

  @@index([hash, role, createdAt])
  @@index([role, createdAt])
}

// An owner-scoped binary asset (e.g. a sandbox-rendered image). Bytes live in
// object storage (GCS); this row is the metadata + ownership record.
model Asset {
  id          String   @id @default(cuid())
  ownerId     String
  workspaceId String?
  mime        String
  sizeBytes   Int
  storageKey  String
  sourceRunId String?
  checksum    String?
  createdAt   DateTime @default(now())

  @@index([ownerId])
}

// The in-workspace AI agent's conversation, one row per message, so the chat
// survives closing the panel and reloading the page and the model can be given
// a short window of recent turns. Owner-scoped (every read and write filters on
// userId), hidden while the workspace is in the trash, removed with it
// (ON DELETE CASCADE), erased with the account and pruned by retention.
// `changeNote` is a compact, id-bearing note of what the agent changed (fed
// back to the model for follow-ups); `meta` is JSON (choices, affected areas,
// credits cost, stop reason) used only to redraw the chat.
model AgentChatMessage {
  id           String    @id @default(cuid())
  userId       String
  workspaceId  String
  role         String
  content      String
  modelContent String?
  changeNote   String?
  changeId     String?
  meta         String?
  createdAt    DateTime  @default(now())
  workspace    Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@index([userId, workspaceId, createdAt])
  @@index([createdAt])
}

// One Web Push subscription per browser or installed app where a student
// turned notifications on (lib/notifications). `endpoint` is a CAPABILITY URL
// issued by the browser's push service: with the keys, it is enough to message
// that device. It is never logged, never exported, never sent back to the
// browser; `endpointHash` (SHA-256) is the lookup and uniqueness key. Only
// endpoints of known push services are accepted (lib/notifications/endpoint.ts).
// Removed when the push service reports it gone (404/410), after repeated
// rejections, when the student turns the device off, and on account erasure.
model PushSubscription {
  id            String    @id @default(cuid())
  userId        String
  endpoint      String
  endpointHash  String    @unique
  p256dh        String
  auth          String
  // A short device label for the settings list ("iPhone", "Chrome · Windows").
  label         String    @default("")
  failures      Int       @default(0)
  lastSuccessAt DateTime?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  @@index([userId])
}

// What a student wants to be reminded of, and when, in their own time zone.
// Times are minutes after local midnight; lead times are JSON number[] of
// days before a due date. `nextCheckAt` is the next instant anything could be
// due for this student (null = nothing to do: no device, or everything off);
// the dispatch only ever reads rows whose `nextCheckAt` has passed, through
// its index, and `leaseUntil` stops two overlapping runs handling one student.
// The weekly recap is opt-in (off by default): `weeklyDay` is the local
// weekday it arrives on (0 = Sunday … 6 = Saturday), `weeklyMinute` the time.
// Email is a second channel for the same reminders, opt-in (`emailEnabled`).
// The address is never stored here: it is read from Clerk at send time.
// `emailBouncedAt` is set when the mail server refused the address for good,
// with `emailBouncedHash`, a keyed hash (HMAC) of the refused address (never
// the address itself): the stop applies to THAT address only, so a student
// whose primary address has changed since is emailed again (and the flag is
// cleared). Turning email on again clears it too.
model NotificationPreference {
  userId          String    @id
  timeZone        String    @default("UTC")
  locale          String    @default("en")
  dailyEnabled    Boolean   @default(true)
  dailyMinute     Int       @default(480)
  deadlineEnabled Boolean   @default(true)
  deadlineMinute  Int       @default(1080)
  deadlineLeads   String    @default("[7,2,1]")
  examLeads       String    @default("[14,7,2,1]")
  streakEnabled   Boolean   @default(true)
  weeklyEnabled   Boolean   @default(false)
  weeklyDay       Int       @default(0)
  weeklyMinute    Int       @default(1080)
  quietEnabled    Boolean   @default(true)
  quietStart      Int       @default(1320)
  quietEnd        Int       @default(420)
  emailEnabled    Boolean   @default(false)
  emailBouncedAt  DateTime?
  emailBouncedHash String?
  nextCheckAt     DateTime?
  leaseUntil      DateTime?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  @@index([nextCheckAt])
}

// What the notification dispatch decided, one row per reminder, so nothing is
// sent twice: a row is claimed (unique userId + dedupeKey) BEFORE sending, so
// overlapping or repeated runs can never send the same reminder again.
// `message` = the row is one notification shown to the student (counts toward
// the daily cap); reminders folded into a grouped notification have false.
// `status`: pending | sent | failed | skipped. Pruned by retention.
model NotificationLog {
  id        String    @id @default(cuid())
  userId    String
  dedupeKey String
  kind      String
  localDate String
  status    String    @default("pending")
  message   Boolean   @default(false)
  createdAt DateTime  @default(now())
  sentAt    DateTime?

  @@unique([userId, dedupeKey])
  @@index([userId, localDate])
  @@index([createdAt])
}

// A message a student sent from the in-app "Send feedback" dialog
// (src/app/app/feedback-actions.ts), read in the operator console
// (/app/admin). `kind`: bug | idea | question | other. `pagePath` is the path
// they were on (never a query string or hash). `contactOk` = they agreed to
// be emailed about it; only then does the console look up their address.
// `status`: new | read | done. Exported with the account and erased with it.
model Feedback {
  id        String   @id @default(cuid())
  userId    String
  kind      String
  message   String
  pagePath  String?
  locale    String?
  contactOk Boolean  @default(false)
  status    String   @default("new")
  createdAt DateTime @default(now())

  @@index([status, createdAt])
  @@index([userId, createdAt])
}

// Why a student deleted their account: the optional question in the delete
// confirmation (components/account/DeleteAccountButton, lib/account/
// deletion-reason.ts). Anonymous by design: no user id, the account's age only
// as a rough bucket, so a row outlives the account it came from. The operator
// console counts the reasons; rows go after two years (lib/ops/retention.ts).
model AccountDeletionReason {
  id        String   @id @default(cuid())
  // One of DELETION_REASONS.
  reason    String
  // Optional free text, at most 500 characters.
  note      String?
  // "free" or "pro" when the account was deleted.
  plan      String
  // How long the account existed: "week" | "month" | "quarter" | "year" | "older".
  tenure    String
  createdAt DateTime @default(now())

  @@index([createdAt])
}

// A withdrawal or cancellation a consumer declared with the statutory online
// functions (/withdraw: "Withdraw from contract here", § 356a BGB; /cancel:
// "Cancel contracts here", § 312k BGB; lib/contract-notices). A legal record,
// not ordinary user content: `receivedAt` is the moment the confirm button
// was used (what decides whether it came in time), set by the server.
// `kind`: withdrawal | cancellation. `contractKind`: pro | pack | other, with
// `contractRef` (the Stripe subscription or checkout session id) when the
// signed-in sender picked a contract of their own. Cancellations carry
// `cancelType` (ordinary | extraordinary), `reason` (extraordinary only) and
// `requestedEnd` (YYYY-MM-DD; null = the earliest possible date).
// `status`: open | done (`handledAt`); the operator processes open ones in
// the console (/app/admin). `ackStatus`: pending | sent | failed |
// not_configured (the acknowledgement of receipt emailed to `email`);
// `operatorNotified`: the operator's own email went out. `stripeOutcome`
// (cancellations only; null = Stripe not touched): scheduled |
// already_scheduled | no_live_subscription | failed, with `proEndsAt`.
// Exported with the account. On account deletion the row is KEPT with
// `userId` cleared (the operator must be able to prove receipt and refund);
// deleted three years after receipt (lib/ops/retention.ts).
model ContractNotice {
  id               String    @id @default(cuid())
  kind             String
  userId           String?
  name             String
  email            String
  contractKind     String
  contractRef      String?
  details          String?
  cancelType       String?
  reason           String?
  requestedEnd     String?
  locale           String
  receivedAt       DateTime  @default(now())
  status           String    @default("open")
  handledAt        DateTime?
  ackStatus        String    @default("pending")
  operatorNotified Boolean   @default(false)
  stripeOutcome    String?
  proEndsAt        DateTime?

  @@index([status, receivedAt])
  @@index([userId])
  @@index([receivedAt])
}

// A public, read-only link to ONE page of a workspace (/s/<token>), made from
// the page's "Share" dialog (src/app/app/share-actions.ts, lib/share). The
// token is the capability: 192 random bits, base64url. Private by default
// (no row = not shared); turning sharing off sets `revokedAt` and the link
// dies for good, turning it on again issues a new token. At most one active
// (revokedAt null) share per page. Visitors see the page's CURRENT content,
// never the workspace's other pages, grades or calendar. `viewCount` is a
// hint (at most one view per address and link per hour, counted in memory),
// not analytics. Removed with the workspace (ON DELETE CASCADE), exported
// (without the token) and erased with the account. Moving the workspace to
// the trash, or deleting the page, revokes its shares (restoring does not
// bring them back). `disabledByOperatorAt`: an operator turned this link off
// after a report (/app/admin); that page cannot be shared again, and a user
// with several such links cannot share any page.
model PageShare {
  id                   String        @id @default(cuid())
  token                String        @unique
  userId               String
  workspaceId          String
  pageId               String
  createdAt            DateTime      @default(now())
  revokedAt            DateTime?
  disabledByOperatorAt DateTime?
  viewCount            Int           @default(0)
  lastViewedAt         DateTime?
  workspace            Workspace     @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  reports      ShareReport[]

  @@index([userId])
  @@index([workspaceId, pageId])
}

// "Report this page" from a visitor of a shared page (/s/<token>), read in
// the operator console (/app/admin). No reporter identity is stored (visitors
// need not be signed in); the form is rate limited per address in memory.
// `reason`: spam | copyright | harmful | personal | other. `status`: new |
// done (set when an operator disables the link or dismisses the reports).
// At most SHARE_REPORTS_OPEN_CAP open reports are kept per share (lib/share/config.ts). Removed with its share
// (ON DELETE CASCADE) and erased with the page owner's account; not part of
// the owner's export (they are other people's messages about the page).
model ShareReport {
  id        String    @id @default(cuid())
  shareId   String
  reason    String
  message   String?
  createdAt DateTime  @default(now())
  status    String    @default("new")
  share     PageShare @relation(fields: [shareId], references: [id], onDelete: Cascade)

  @@index([status, createdAt])
  @@index([shareId])
}

// Server errors grouped by kind for the operator console's "Errors" panel
// (/app/admin). reportError (lib/ops/report-error.ts) still writes every error
// to the log in full; it also counts it here, buffered in memory and written
// at most every 30 seconds (lib/ops/error-events.ts). Operational data only:
// no user ids, emails or content. `message` and `sample` (the first stack
// frames) are scrubbed like the log line, with ids replaced. `fingerprint` is
// a hash of source + route + the message with numbers and ids normalized, so
// one kind of error is one row; `count` is every occurrence since
// `firstSeen`. `release` is the DEPLOYMENT_VERSION it was last seen in.
// Rows not seen for 30 days are deleted by the maintenance job; the console
// can clear one sooner.
model ErrorEvent {
  fingerprint String   @id
  source      String
  route       String?
  message     String
  sample      String?
  count       Int
  firstSeen   DateTime
  lastSeen    DateTime
  release     String?

  @@index([lastSeen])
}
