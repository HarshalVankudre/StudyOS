# StudyOS environment variables. Names and purpose only, never values.
# Copy to .env.local for local development. The canonical list, with which
# feature each variable switches on, lives in src/lib/ops/env.ts; the server
# logs a summary at startup, and GET /api/health with
# `Authorization: Bearer $MAINTENANCE_SECRET` reports a secret-free status
# (anonymous callers get only { ok }; 503 while required variables are missing).
#
# REQUIRED in production (the server refuses to start without them):
#   DATABASE_URL, CLERK_SECRET_KEY, NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY,
#   and the AI key the configured models need (OPENROUTER_API_KEY by default,
#   ANTHROPIC_API_KEY when a model is a bare claude-* id).

# ---- Core -------------------------------------------------------------------
# Pooled Postgres connection used at runtime. REQUIRED.
DATABASE_URL=
# Direct Postgres connection used by prisma migrate.
DATABASE_URL_UNPOOLED=
# Clerk backend key. REQUIRED.
CLERK_SECRET_KEY=
# Clerk publishable key; inlined at build time (Docker build arg). REQUIRED.
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
# Clerk page paths and post-auth redirects.
NEXT_PUBLIC_CLERK_SIGN_IN_URL=
NEXT_PUBLIC_CLERK_SIGN_UP_URL=
NEXT_PUBLIC_CLERK_SIGN_IN_FALLBACK_REDIRECT_URL=
NEXT_PUBLIC_CLERK_SIGN_UP_FALLBACK_REDIRECT_URL=
# Canonical public URL (SEO, calendar links, links in reminder emails). APP_URL
# wins over NEXT_PUBLIC_APP_URL. On the app server: the app's own origin (no
# redirect), as the emails' one-click unsubscribe link is built from it.
APP_URL=
NEXT_PUBLIC_APP_URL=
# Public support address shown on the landing, pricing and legal pages
# (src/lib/site.ts). Falls back to the owner's address when unset.
STUDYOS_SUPPORT_EMAIL=
# Where vulnerability reports go (/.well-known/security.txt); falls back to
# STUDYOS_SUPPORT_EMAIL.
STUDYOS_SECURITY_EMAIL=
# Comma-separated Clerk user ids (user_...) allowed into the operator console
# at /app/admin. Unset or empty = nobody; everyone else gets a 404 there.
STUDYOS_ADMIN_USER_IDS=
# 1 = start in production even with required variables missing (local `next start` only).
STUDYOS_ALLOW_INCOMPLETE_ENV=
# Website deployment only (public pages, e.g. on Vercel): the origin of the app
# deployment, e.g. https://app.example.com. App-only paths (/app, /generate,
# /sign-in, /sign-up, /api, /embed) are redirected there, and DATABASE_URL and
# the AI key are not required. Leave empty on the app deployment and locally.
STUDYOS_APP_ORIGIN=

# ---- Legal notice (Impressum) --------------------------------------------------
# Who operates StudyOS, shown at /legal-notice (src/lib/legal/operator.ts). A
# legal notice is required in Germany (§ 5 DDG) and the EU. The page and its
# footer links exist only once NAME and ADDRESS are both set; in production the
# startup log warns until then. Public pages: set these on the website
# deployment (Vercel) as well as on the app server. Not secret.
# Person or company name.
STUDYOS_OPERATOR_NAME=
# Postal address; separate lines with \n or |, e.g. Musterstraße 1|10115 Berlin|Germany
STUDYOS_OPERATOR_ADDRESS=
# Contact email; falls back to STUDYOS_SUPPORT_EMAIL.
STUDYOS_OPERATOR_EMAIL=
# Optional: phone, commercial register entry (court and number), VAT ID, and the
# person responsible for the content.
STUDYOS_OPERATOR_PHONE=
STUDYOS_OPERATOR_REGISTER=
STUDYOS_OPERATOR_VAT_ID=
STUDYOS_OPERATOR_RESPONSIBLE=

# ---- AI ---------------------------------------------------------------------
# OpenRouter key; needed when a plan model is an OpenRouter slug (the default).
OPENROUTER_API_KEY=
# Anthropic key; needed when a plan model is a bare claude-* id.
ANTHROPIC_API_KEY=
# Model per plan (default z-ai/glm-5.2).
STUDYOS_FREE_MODEL=
STUDYOS_PRO_MODEL=
# Comma-separated hosts the agent may read from the web; empty = none.
AGENT_FETCH_ALLOWLIST=

# ---- Billing (Stripe); all three switch billing on ---------------------------
STRIPE_SECRET_KEY=
# Price id of the Pro subscription (a single-currency Price: one with extra
# currencies under currency_options is not sold).
STRIPE_PRICE_PRO=
# Price id of annual Pro billing; annual is offered only when this is set
# (an active, single-currency yearly Price).
STRIPE_PRICE_PRO_ANNUAL=
# Signing secret of the /api/stripe/webhook endpoint.
STRIPE_WEBHOOK_SECRET=
# Pro prices in USD shown only while billing is off (src/lib/plan-pricing.ts).
# With billing configured every page shows what the Stripe prices above
# charge, in their currency, and these are ignored. Defaults (the price list,
# src/lib/price-list.ts): 7.99 a month and 39.99 a year.
STUDYOS_PRO_MONTHLY_PRICE=
STUDYOS_PRO_ANNUAL_PRICE=
# Stripe publishable key (build arg; not used by the client today).
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=

# ---- Selling in the EU (src/lib/checkout-config.ts); each is off until set ---
# The switches below take 1/true/yes/on (on) or 0/false/no/off (off); any
# other value is off and the startup log names it.
# Optional Stripe price id of the credit pack: an active, flat, one-time price
# in a single currency (any one; no extra currency_options). Set: the pack's
# checkout charges it and every page shows its amount and currency; while it
# is unreadable or not such a price, the pack is not sold. Unset: the price
# list's USD price, as an inline price.
STRIPE_PRICE_CREDIT_PACK=
# 1 = Stripe Tax on both checkouts (required billing address, saved to the
# customer; VAT ID collection for businesses, reverse charge by Stripe Tax).
# Set up Stripe Tax in the Dashboard FIRST (origin address, registrations,
# default tax code and tax behavior), or checkout creation fails. New
# checkouts only: existing subscriptions keep their tax settings.
STRIPE_AUTOMATIC_TAX=
# inclusive (default: the price shown is the price paid, the EU consumer norm)
# or exclusive (tax added at checkout). Sets the inline pack price's tax
# behavior and the VAT note on the pricing pages. The Stripe Prices (Pro,
# annual, pack) must come out the same: their own tax behavior, else the
# Stripe Tax default (inferred_by_currency counts as unknown). One that does
# not, or cannot be told, is not sold (reported once).
STRIPE_TAX_BEHAVIOR=
# 1 = an invoice PDF (with the tax) for every credit pack; subscriptions
# produce invoices anyway. Stripe may charge an invoicing fee for these.
# (With STRIPE_TERMS_CONSENT on, packs get an invoice anyway.)
STRIPE_PACK_INVOICES=
# 1 = a required Terms checkbox on both checkouts, with the right-of-withdrawal
# text in the student's language. Each credit pack then also gets an invoice
# whose footer confirms the consent, and its payment description (on Stripe's
# receipt) says so too: switch on Stripe's customer emails for successful
# payments and paid invoices (Dashboard, Settings, Customer emails), or the
# buyer never receives them. Stripe requires the Terms of service URL in the
# Dashboard (Settings, Public details) or checkout creation fails, and /terms
# must state the same withdrawal rules.
STRIPE_TERMS_CONSENT=

# ---- Deploys ------------------------------------------------------------------
# Build-time only (Docker build arg; Cloud Build passes its build id): the id
# of this build, so a browser tab still running the previous build is
# recognised during a rolling deploy. Leave empty for local development.
DEPLOYMENT_VERSION=

# ---- Assets and render sandbox ----------------------------------------------
# GCS bucket for rendered images. Also read at build time (Docker build arg):
# next.config.ts limits the CSP img-src to this bucket.
ASSETS_BUCKET=
# Service-account key path when running outside Google Cloud.
GOOGLE_APPLICATION_CREDENTIALS=
# 1 = enable the Daytona render sandbox tool.
AGENT_SANDBOX=
# Daytona API key.
DAYTONA_API_KEY=
# Prebuilt Daytona snapshot with the render toolchain.
STUDYOS_SANDBOX_SNAPSHOT=
# Comma-separated IPv4 CIDRs the sandbox may reach; empty = all network blocked.
STUDYOS_SANDBOX_NETWORK_ALLOWLIST=

# ---- Operations -------------------------------------------------------------
# Signing secret of the Clerk webhook (/api/clerk/webhook, event user.deleted).
# Optional for starting, but set it as soon as billing is live: without it the
# route stays off and the startup log warns that accounts deleted in Clerk's
# own profile screen keep their data and their subscription.
CLERK_WEBHOOK_SIGNING_SECRET=
# Bearer secret for POST /api/ops/maintenance (Cloud Scheduler); route is 404 without it.
# Also authorizes POST /api/ops/notifications (the notifications dispatch).
MAINTENANCE_SECRET=

# ---- Notifications (Web Push); all three switch notifications on ------------
# Generate the key pair ONCE and keep it (a new pair makes every device
# re-subscribe the next time its student opens StudyOS):
#   node -e "const e=require('crypto').createECDH('prime256v1');e.generateKeys();console.log('VAPID_PUBLIC_KEY='+e.getPublicKey('base64url'));console.log('VAPID_PRIVATE_KEY='+e.getPrivateKey('base64url'))"
# Then schedule POST /api/ops/notifications every 5 minutes with
# `Authorization: Bearer $MAINTENANCE_SECRET` (see src/lib/notifications/dispatch.ts).
VAPID_PUBLIC_KEY=
# Secret.
VAPID_PRIVATE_KEY=
# mailto:you@yourdomain or an https URL; push services use it to reach the sender.
VAPID_SUBJECT=

# ---- Email reminders (plain SMTP); SMTP_URL and MAIL_FROM switch them on ----
# The same reminders as push, for students who turn on "Also send reminders by
# email" in Settings (to their verified Clerk address, never stored). Any
# provider with SMTP works: Postmark, Brevo, Amazon SES, Resend, Mailgun, ...
# Sent by the same dispatch as push (POST /api/ops/notifications above).
# Before going live: set up SPF, DKIM and DMARC for the MAIL_FROM domain with
# the provider. Secret. smtps://...:465 = TLS from the start; smtp://...:587 =
# STARTTLS (required except on localhost). Percent-encode special characters
# in the user and password (@ is %40, : is %3A, / is %2F).
SMTP_URL=
# e.g. StudyOS <hello@example.com>
MAIL_FROM=
# Optional Reply-To. Defaults to MAIL_FROM's address. (Unsubscribing is by the
# one-click HTTPS link only, built on APP_URL, which must be the app's own
# origin, answering without a redirect.)
MAIL_REPLY_TO=
# Optional secret (any long random string, 32+ characters) that signs the
# one-click unsubscribe links. Unset = a key derived from CLERK_SECRET_KEY, so
# rotating the Clerk key would break the links in emails already sent; set it
# to make the two independent (links signed before keep working while the
# Clerk key is unchanged). To rotate it: move the old value to
# UNSUBSCRIBE_SECRET_PREVIOUS, set a new one; links signed with either work.
UNSUBSCRIBE_SECRET=
UNSUBSCRIBE_SECRET_PREVIOUS=
# X-Forwarded-For entries our own proxies append: 1 (default) = Cloud Run alone,
# 2 = a Google external Application Load Balancer in front of Cloud Run.
STUDYOS_TRUSTED_PROXY_HOPS=
# Server errors are counted (grouped, scrubbed, no user ids) for the Errors
# section of the operator console. Set to off to stop that; the log line stays.
STUDYOS_ERROR_EVENTS=
# The invite program's kill switch. Set to off to pause it: invite links go to
# the landing page, nothing new is attributed or rewarded (pending referrals
# wait, and are rewarded once it is back on), and the invite cards say so.
STUDYOS_REFERRALS=
# Secret (any long random string) that encrypts students' connected calendar
# feed links at rest. Optional: in production without it, connecting calendar
# links is switched off (students are told; .ics upload still works) and the
# startup log warns. Unset in development = stored encoded only. Changing it =
# students reconnect.
FEED_URL_KEY=

# ---- Local development only -------------------------------------------------
# Plan override (free|pro) for users without a subscription.
STUDYOS_PLAN=
# Force a visitor country for locale detection (e.g. DE).
STUDYOS_GEO_COUNTRY=
