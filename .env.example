# StudyOS environment variables. Names and purpose only, never values.
# Copy to .env.local for local development. The canonical list, with which
# feature each variable switches on, lives in src/lib/ops/env.ts; the server
# logs a summary at startup, and GET /api/health with
# `Authorization: Bearer $MAINTENANCE_SECRET` reports a secret-free status
# (anonymous callers get only { ok }; 503 while required variables are missing).
#
# REQUIRED in production (the server refuses to start without them):
#   DATABASE_URL, CLERK_SECRET_KEY, NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY,
#   and the AI key the configured models need (OPENROUTER_API_KEY by default,
#   ANTHROPIC_API_KEY when a model is a bare claude-* id).

# ---- Core -------------------------------------------------------------------
# Pooled Postgres connection used at runtime. REQUIRED.
DATABASE_URL=
# Direct Postgres connection used by prisma migrate.
DATABASE_URL_UNPOOLED=
# Clerk backend key. REQUIRED.
CLERK_SECRET_KEY=
# Clerk publishable key; inlined at build time (Docker build arg). REQUIRED.
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
# Clerk page paths and post-auth redirects.
NEXT_PUBLIC_CLERK_SIGN_IN_URL=
NEXT_PUBLIC_CLERK_SIGN_UP_URL=
NEXT_PUBLIC_CLERK_SIGN_IN_FALLBACK_REDIRECT_URL=
NEXT_PUBLIC_CLERK_SIGN_UP_FALLBACK_REDIRECT_URL=
# Canonical public URL (SEO, calendar links). APP_URL wins over NEXT_PUBLIC_APP_URL.
APP_URL=
NEXT_PUBLIC_APP_URL=
# Public support address shown on the landing, pricing and legal pages
# (src/lib/site.ts). Falls back to the owner's address when unset.
STUDYOS_SUPPORT_EMAIL=
# 1 = start in production even with required variables missing (local `next start` only).
STUDYOS_ALLOW_INCOMPLETE_ENV=

# ---- AI ---------------------------------------------------------------------
# OpenRouter key; needed when a plan model is an OpenRouter slug (the default).
OPENROUTER_API_KEY=
# Anthropic key; needed when a plan model is a bare claude-* id.
ANTHROPIC_API_KEY=
# Model per plan (default z-ai/glm-5.2).
STUDYOS_FREE_MODEL=
STUDYOS_PRO_MODEL=
# Comma-separated hosts the agent may read from the web; empty = none.
AGENT_FETCH_ALLOWLIST=

# ---- Billing (Stripe); all three switch billing on ---------------------------
STRIPE_SECRET_KEY=
# Price id of the Pro subscription.
STRIPE_PRICE_PRO=
# Price id of annual Pro billing; annual is offered only when this is set.
STRIPE_PRICE_PRO_ANNUAL=
# Signing secret of the /api/stripe/webhook endpoint.
STRIPE_WEBHOOK_SECRET=
# Displayed Pro prices in USD (src/lib/plan-pricing.ts). They must match what
# the Stripe prices above charge. Monthly defaults to 5; annual has no default
# and the annual option is shown only when it and STRIPE_PRICE_PRO_ANNUAL are set.
STUDYOS_PRO_MONTHLY_PRICE=
STUDYOS_PRO_ANNUAL_PRICE=
# Stripe publishable key (build arg; not used by the client today).
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=

# ---- Assets and render sandbox ----------------------------------------------
# GCS bucket for rendered images. Also read at build time (Docker build arg):
# next.config.ts limits the CSP img-src to this bucket.
ASSETS_BUCKET=
# Service-account key path when running outside Google Cloud.
GOOGLE_APPLICATION_CREDENTIALS=
# 1 = enable the Daytona render sandbox tool.
AGENT_SANDBOX=
# Daytona API key.
DAYTONA_API_KEY=
# Prebuilt Daytona snapshot with the render toolchain.
STUDYOS_SANDBOX_SNAPSHOT=
# Comma-separated IPv4 CIDRs the sandbox may reach; empty = all network blocked.
STUDYOS_SANDBOX_NETWORK_ALLOWLIST=

# ---- Operations -------------------------------------------------------------
# Signing secret of the Clerk webhook (/api/clerk/webhook, event user.deleted).
# REQUIRED in production once billing is configured: it is how an account
# deleted in Clerk's own UI stops being billed.
CLERK_WEBHOOK_SIGNING_SECRET=
# Bearer secret for POST /api/ops/maintenance (Cloud Scheduler); route is 404 without it.
# Also authorizes POST /api/ops/notifications (the notifications dispatch).
MAINTENANCE_SECRET=

# ---- Notifications (Web Push); all three switch notifications on ------------
# Generate the key pair ONCE and keep it (a new pair makes every device
# re-subscribe the next time its student opens StudyOS):
#   node -e "const e=require('crypto').createECDH('prime256v1');e.generateKeys();console.log('VAPID_PUBLIC_KEY='+e.getPublicKey('base64url'));console.log('VAPID_PRIVATE_KEY='+e.getPrivateKey('base64url'))"
# Then schedule POST /api/ops/notifications every 5 minutes with
# `Authorization: Bearer $MAINTENANCE_SECRET` (see src/lib/notifications/dispatch.ts).
VAPID_PUBLIC_KEY=
# Secret.
VAPID_PRIVATE_KEY=
# mailto:you@yourdomain or an https URL; push services use it to reach the sender.
VAPID_SUBJECT=
# X-Forwarded-For entries our own proxies append: 1 (default) = Cloud Run alone,
# 2 = a Google external Application Load Balancer in front of Cloud Run.
STUDYOS_TRUSTED_PROXY_HOPS=
# Secret (any long random string) that encrypts students' connected calendar
# feed links at rest. Unset = stored encoded only. Changing it = students reconnect.
FEED_URL_KEY=

# ---- Local development only -------------------------------------------------
# Plan override (free|pro) for users without a subscription.
STUDYOS_PLAN=
# Force a visitor country for locale detection (e.g. DE).
STUDYOS_GEO_COUNTRY=
