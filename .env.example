# StudyOS environment variables. Names and purpose only, never values.
# Copy to .env.local for local development. The canonical list, with which
# feature each variable switches on, lives in src/lib/ops/env.ts; the server
# logs a summary at startup and GET /api/health reports a secret-free status.
#
# REQUIRED in production (the server refuses to start without them):
#   DATABASE_URL, CLERK_SECRET_KEY, NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY,
#   and the AI key the configured models need (OPENROUTER_API_KEY by default,
#   ANTHROPIC_API_KEY when a model is a bare claude-* id).

# ---- Core -------------------------------------------------------------------
# Pooled Postgres connection used at runtime. REQUIRED.
DATABASE_URL=
# Direct Postgres connection used by prisma migrate.
DATABASE_URL_UNPOOLED=
# Clerk backend key. REQUIRED.
CLERK_SECRET_KEY=
# Clerk publishable key; inlined at build time (Docker build arg). REQUIRED.
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
# Clerk page paths and post-auth redirects.
NEXT_PUBLIC_CLERK_SIGN_IN_URL=
NEXT_PUBLIC_CLERK_SIGN_UP_URL=
NEXT_PUBLIC_CLERK_SIGN_IN_FALLBACK_REDIRECT_URL=
NEXT_PUBLIC_CLERK_SIGN_UP_FALLBACK_REDIRECT_URL=
# Canonical public URL (SEO, calendar links). APP_URL wins over NEXT_PUBLIC_APP_URL.
APP_URL=
NEXT_PUBLIC_APP_URL=
# 1 = start in production even with required variables missing (local `next start` only).
STUDYOS_ALLOW_INCOMPLETE_ENV=

# ---- AI ---------------------------------------------------------------------
# OpenRouter key; needed when a plan model is an OpenRouter slug (the default).
OPENROUTER_API_KEY=
# Anthropic key; needed when a plan model is a bare claude-* id.
ANTHROPIC_API_KEY=
# Model per plan (default z-ai/glm-5.2).
STUDYOS_FREE_MODEL=
STUDYOS_PRO_MODEL=
# 1 = tool-loop chat agent; unset = legacy planner/editor.
AUTHENTIC_AGENT=
# Comma-separated hosts the agent may read from the web; empty = none.
AGENT_FETCH_ALLOWLIST=

# ---- Billing (Stripe); all three switch billing on ---------------------------
STRIPE_SECRET_KEY=
# Price id of the Pro subscription.
STRIPE_PRICE_PRO=
# Signing secret of the /api/stripe/webhook endpoint.
STRIPE_WEBHOOK_SECRET=
# Stripe publishable key (build arg; not used by the client today).
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=

# ---- Assets and render sandbox ----------------------------------------------
# GCS bucket for rendered images.
ASSETS_BUCKET=
# Service-account key path when running outside Google Cloud.
GOOGLE_APPLICATION_CREDENTIALS=
# 1 = enable the Daytona render sandbox tool.
AGENT_SANDBOX=
# Daytona API key.
DAYTONA_API_KEY=
# Prebuilt Daytona snapshot with the render toolchain.
STUDYOS_SANDBOX_SNAPSHOT=
# Comma-separated IPv4 CIDRs the sandbox may reach; empty = all network blocked.
STUDYOS_SANDBOX_NETWORK_ALLOWLIST=

# ---- Operations -------------------------------------------------------------
# Signing secret of the Clerk webhook (/api/clerk/webhook, event user.deleted).
CLERK_WEBHOOK_SIGNING_SECRET=
# Bearer secret for POST /api/ops/maintenance (Cloud Scheduler); route is 404 without it.
MAINTENANCE_SECRET=

# ---- Local development only -------------------------------------------------
# Plan override (free|pro) for users without a subscription.
STUDYOS_PLAN=
# Force a visitor country for locale detection (e.g. DE).
STUDYOS_GEO_COUNTRY=
